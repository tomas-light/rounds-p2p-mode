<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>RoundsP2P</AssemblyName>
    <Version>0.2.3</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RoundsP2P.Core\RoundsP2P.Core.csproj" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="PhotonUnityNetworking" HintPath="$(GameManagedDir)\PhotonUnityNetworking.dll" Private="false" />
    <Reference Include="PhotonRealtime" HintPath="$(GameManagedDir)\PhotonRealtime.dll" Private="false" />
    <Reference Include="Photon3Unity3D" HintPath="$(GameManagedDir)\Photon3Unity3D.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GameManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.Physics2DModule" HintPath="$(GameManagedDir)\UnityEngine.Physics2DModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(GameManagedDir)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="InControl" HintPath="$(GameManagedDir)\InControl.dll" Private="false" />
    <Reference Include="com.rlabrecque.steamworks.net" HintPath="$(GameManagedDir)\com.rlabrecque.steamworks.net.dll" Private="false" />
    <Reference Include="SteamPlatformRuntime" HintPath="$(GameManagedDir)\SteamPlatformRuntime.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManagedDir)\Assembly-CSharp.dll')" Text="Set ROUNDS_GAME_DIR or GameDir to your current Steam ROUNDS installation." />
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.dll')" Text="Run scripts/prepare.ps1 or set ROUNDS_BEPINEX_DIR to a BepInEx 5 directory." />
  </Target>
</Project>
