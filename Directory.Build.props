<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GameDir Condition="'$(GameDir)' == ''">$(ROUNDS_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\ROUNDS</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(ROUNDS_BEPINEX_DIR)</BepInExDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(MSBuildThisFileDirectory).cache\BepInEx</BepInExDir>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)local.props" Condition="Exists('$(MSBuildThisFileDirectory)local.props')" />
  <PropertyGroup>
    <GameManagedDir>$(GameDir)\ROUNDS_Data\Managed</GameManagedDir>
  </PropertyGroup>
</Project>
